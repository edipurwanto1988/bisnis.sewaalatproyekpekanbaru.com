---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';
import ArticleIndexContent from '../../components/ArticleIndexContent.astro';

const articlesPerPage = 9;
const totalPages = Math.ceil(articles.length / articlesPerPage);
const pageArticles = articles.slice(0, articlesPerPage);
---
<BaseLayout
  title="Artikel SEO Sewa Alat Berat"
  description="Kumpulan artikel SEO tentang sewa alat berat Pekanbaru, harga rental, excavator, bulldozer, crane, forklift, dump truck, jalan, aspal, beton, dan perkebunan."
>
  <ArticleIndexContent
    pageArticles={pageArticles}
    totalArticles={articles.length}
    currentPage={1}
    totalPages={totalPages}
  />
</BaseLayout>
