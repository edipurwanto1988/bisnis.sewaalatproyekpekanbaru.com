---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';

const formatDate = (date?: string) =>
  date
    ? new Intl.DateTimeFormat('id-ID', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC'
      }).format(new Date(`${date}T00:00:00.000Z`))
    : '';
---
<BaseLayout
  title="Artikel SEO Sewa Alat Berat"
  description="Kumpulan artikel SEO tentang sewa alat berat Pekanbaru, harga rental, excavator, bulldozer, crane, forklift, dump truck, jalan, aspal, beton, dan perkebunan."
>
  <main>
    <section class="section article-index">
      <div class="container">
        <p class="eyebrow">Pusat artikel</p>
        <h1>{articles.length} Artikel SEO Sewa Alat Berat Pekanbaru</h1>
        <p>Konten informatif untuk membantu memilih unit, memahami proses sewa, dan merencanakan pekerjaan konstruksi atau perkebunan di Pekanbaru.</p>
        <div class="grid">
          {articles.map((article) => (
            <article class="card">
              <div class="meta">
                <span>{article.category}</span>
                {article.publishedDate && <time datetime={article.publishedDate}>{formatDate(article.publishedDate)}</time>}
              </div>
              <h2><a href={`/artikel/${article.slug}`}>{article.title}</a></h2>
              <p>{article.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .article-index {
    background: #ffffff;
  }

  h1 {
    max-width: 850px;
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .article-index > .container > p:not(.eyebrow) {
    max-width: 720px;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 32px;
  }

  article {
    padding: 22px;
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  article span {
    color: var(--green-2);
    font-size: 0.8rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  time {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 750;
    white-space: nowrap;
  }

  h2 {
    margin: 0 0 10px;
    font-size: 1.2rem;
    line-height: 1.28;
  }

  h2 a:hover {
    color: var(--green-2);
  }

  article p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
