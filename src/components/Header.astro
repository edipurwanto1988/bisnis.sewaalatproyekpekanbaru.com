---
const nav = [
  { href: '/', label: 'Beranda' },
  { href: '/#alat', label: 'Alat Berat' },
  { href: '/#layanan', label: 'Layanan' },
  { href: '/artikel', label: 'Artikel' },
  { href: '/#kontak', label: 'Kontak' }
];
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="Sewa Alat Berat Pekanbaru">
      <span class="brand-mark">SA</span>
      <span>
        <strong>Sewa Alat Berat</strong>
        <small>Pekanbaru</small>
      </span>
    </a>
    <nav aria-label="Navigasi utama">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="nav-cta" href="https://wa.me/682385023881?text=Halo%2C%20saya%20ingin%20konsultasi%20sewa%20alat%20berat%20di%20Pekanbaru">Konsultasi</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgba(220, 228, 223, 0.84);
    background: rgba(247, 249, 246, 0.92);
    backdrop-filter: blur(14px);
  }

  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    gap: 22px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-width: 208px;
    gap: 12px;
    font-weight: 900;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background: var(--green);
    color: var(--lime);
    font-size: 0.9rem;
  }

  .brand strong,
  .brand small {
    display: block;
    line-height: 1.15;
  }

  .brand small {
    color: var(--muted);
    font-weight: 700;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    gap: 6px;
  }

  nav a {
    padding: 9px 11px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 750;
  }

  nav a:hover {
    background: #edf3ef;
    color: var(--green);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 8px;
    background: var(--amber);
    color: #2d2514;
    font-weight: 900;
  }

  @media (max-width: 820px) {
    .nav-wrap {
      min-height: auto;
      padding-top: 12px;
      padding-bottom: 12px;
      flex-wrap: wrap;
      gap: 12px;
    }

    nav {
      order: 3;
      justify-content: flex-start;
      width: 100%;
      flex-wrap: wrap;
      gap: 8px;
    }

    .brand {
      min-width: auto;
      flex: 1 1 210px;
    }
  }

  @media (max-width: 560px) {
    .nav-wrap {
      align-items: flex-start;
    }

    .brand {
      flex: 1 1 0;
      min-width: 0;
      gap: 10px;
    }

    .brand-mark {
      width: 38px;
      height: 38px;
      flex: 0 0 38px;
      font-size: 0.82rem;
    }

    .brand span:last-child {
      min-width: 0;
    }

    .brand strong {
      font-size: 0.95rem;
    }

    .brand small {
      font-size: 0.78rem;
    }

    .nav-cta {
      min-height: 38px;
      padding: 0 11px;
      font-size: 0.88rem;
      white-space: nowrap;
    }

    nav {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
    }

    nav a {
      display: inline-flex;
      min-height: 38px;
      align-items: center;
      justify-content: center;
      padding: 8px 7px;
      text-align: center;
      font-size: 0.84rem;
    }
  }

  @media (max-width: 360px) {
    nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
