---
const whatsappUrl =
  'https://wa.me/682385023881?text=Halo%2C%20saya%20ingin%20konsultasi%20sewa%20alat%20berat%20di%20Pekanbaru';
---
<a class="floating-whatsapp" href={whatsappUrl} aria-label="Konsultasi via WhatsApp">
  <span class="wa-icon" aria-hidden="true">
    <svg viewBox="0 0 32 32" role="img">
      <path d="M16 3.2A12.7 12.7 0 0 0 5.1 22.4L3.6 28.8l6.5-1.7A12.7 12.7 0 1 0 16 3.2Zm0 2.4a10.3 10.3 0 0 1 8.7 15.8 10.3 10.3 0 0 1-13.9 3.4l-.4-.2-3.7 1 1-3.6-.3-.4A10.3 10.3 0 0 1 16 5.6Zm-4.2 5.1c-.2 0-.5.1-.8.4-.3.4-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.2 5 4.4 2.5 1 3 .8 3.6.8.5-.1 1.7-.7 2-1.4.2-.7.2-1.3.1-1.4l-.6-.3-1.9-.9c-.3-.1-.5-.2-.7.2l-.9 1.1c-.2.2-.3.3-.6.1-.3-.1-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6l-.9-2.1c-.2-.5-.5-.5-.7-.5h-.8Z" />
    </svg>
  </span>
  <span class="wa-text">WhatsApp</span>
</a>

<style>
  .floating-whatsapp {
    position: fixed;
    right: 22px;
    bottom: max(34px, env(safe-area-inset-bottom));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 16px 0 12px;
    border-radius: 999px;
    background: #25d366;
    color: #ffffff;
    font-weight: 900;
    box-shadow: 0 16px 34px rgba(15, 61, 53, 0.28);
  }

  .wa-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }

  svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  @media (max-width: 560px) {
    .floating-whatsapp {
      right: 16px;
      bottom: max(24px, env(safe-area-inset-bottom));
      min-height: 50px;
      padding: 0;
      width: 50px;
      justify-content: center;
    }

    .wa-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }
</style>
