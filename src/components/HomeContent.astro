---
import { featuredArticles, heavyEquipment } from '../data/articles';
---
<main>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Rental alat berat Pekanbaru dan Riau</p>
        <h1>Sewa Alat Berat Pekanbaru Profesional.</h1>
        <p>Unit lengkap untuk konstruksi, jalan, gudang, tambang material, perkebunan, drainase, land clearing, dan mobilisasi alat berat.</p>
        <div class="hero-actions">
          <a class="button" href="https://wa.me/682385023881?text=Halo%2C%20saya%20ingin%20sewa%20alat%20berat%20di%20Pekanbaru">Minta Penawaran</a>
          <a class="button secondary" href="#alat">Lihat Unit</a>
        </div>
      </div>
      <div class="hero-visual" aria-label="Ilustrasi proyek alat berat">
        <div class="sun"></div>
        <div class="machine">
          <span class="arm"></span>
          <span class="boom"></span>
          <span class="bucket"></span>
          <span class="body"></span>
          <span class="track"></span>
        </div>
        <div class="stats card">
          <strong>37+</strong>
          <span>jenis alat berat dan unit pendukung</span>
        </div>
      </div>
    </div>
  </section>

  <section id="layanan" class="section">
    <div class="container">
      <p class="eyebrow">Solusi proyek</p>
      <h2 class="section-title">Layanan sewa alat berat yang disiapkan untuk kebutuhan lapangan.</h2>
      <div class="service-grid">
        <article class="card">
          <h3>Pekerjaan tanah</h3>
          <p>Galian, timbunan, cut and fill, land clearing, kanal, parit, dan perataan area.</p>
        </article>
        <article class="card">
          <h3>Jalan dan infrastruktur</h3>
          <p>Base course, grading, pemadatan, penyiraman, pengaspalan, dan perawatan akses proyek.</p>
        </article>
        <article class="card">
          <h3>Angkut dan lifting</h3>
          <p>Dump truck, lowbed trailer, forklift, crane, telehandler, dan pengangkatan material berat.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="alat" class="section equipment-section">
    <div class="container">
      <p class="eyebrow">Daftar unit</p>
      <h2 class="section-title">Semua alat berat yang umum disewa untuk proyek di Pekanbaru.</h2>
      <p class="section-copy">Pilih unit berdasarkan pekerjaan, volume, kondisi medan, dan target durasi. Tim dapat membantu merekomendasikan kombinasi alat agar biaya lebih efisien.</p>
      <div class="equipment-list">
        {heavyEquipment.map((item) => <span>{item}</span>)}
      </div>
    </div>
  </section>

  <section class="section process-section">
    <div class="container process-grid">
      <div>
        <p class="eyebrow">Alur cepat</p>
        <h2 class="section-title">Dari konsultasi sampai unit bekerja di lokasi.</h2>
      </div>
      <ol class="steps">
        <li><strong>Kirim kebutuhan.</strong><span>Jenis pekerjaan, lokasi, estimasi volume, dan tanggal mulai.</span></li>
        <li><strong>Rekomendasi alat.</strong><span>Unit disesuaikan dengan medan, akses, target harian, dan anggaran.</span></li>
        <li><strong>Mobilisasi.</strong><span>Unit, operator, dan armada pendukung dijadwalkan menuju lokasi.</span></li>
        <li><strong>Monitoring.</strong><span>Progress harian dipantau agar ritase, jam kerja, dan hasil tetap terkendali.</span></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="article-head">
        <div>
          <p class="eyebrow">Artikel SEO</p>
          <h2 class="section-title">Panduan sewa alat berat untuk perencanaan proyek.</h2>
        </div>
        <a class="button secondary" href="/artikel">Semua Artikel</a>
      </div>
      <div class="article-grid">
        {featuredArticles.map((article) => (
          <article class="card article-card">
            <span>{article.category}</span>
            <h3><a href={`/artikel/${article.slug}`}>{article.title}</a></h3>
            <p>{article.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</main>

<style>
  .hero {
    min-height: calc(100svh - 76px);
    padding: 74px 0 42px;
    display: grid;
    align-items: center;
    background:
      linear-gradient(120deg, rgba(15, 61, 53, 0.08), rgba(245, 181, 68, 0.12)),
      var(--surface);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(360px, 0.98fr);
    gap: 42px;
    align-items: center;
  }

  .hero h1 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 5.8rem);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .hero-copy > p:not(.eyebrow) {
    max-width: 650px;
    color: var(--muted);
    font-size: 1.16rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .hero-visual {
    position: relative;
    min-height: 440px;
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.7), rgba(255,255,255,0.18)),
      repeating-linear-gradient(0deg, transparent 0 48px, rgba(15, 61, 53, 0.08) 49px 50px),
      #dfe7df;
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .hero-visual::before {
    content: "";
    position: absolute;
    inset: auto -8% 0;
    height: 34%;
    background: linear-gradient(180deg, #89967f, #4d5f55);
    clip-path: polygon(0 45%, 24% 18%, 51% 32%, 76% 8%, 100% 36%, 100% 100%, 0 100%);
  }

  .sun {
    position: absolute;
    right: 42px;
    top: 38px;
    width: 82px;
    height: 82px;
    border-radius: 50%;
    background: var(--amber);
  }

  .machine {
    position: absolute;
    left: 42px;
    right: 34px;
    bottom: 84px;
    height: 220px;
  }

  .machine span {
    position: absolute;
    display: block;
  }

  .body {
    left: 62px;
    bottom: 58px;
    width: 210px;
    height: 92px;
    border-radius: 8px 30px 8px 8px;
    background: #f5b544;
    box-shadow: inset 45px 0 0 #d99322;
  }

  .track {
    left: 30px;
    bottom: 22px;
    width: 290px;
    height: 54px;
    border-radius: 999px;
    background: #1f2b2a;
    box-shadow: inset 16px 0 0 #3c4b49, inset -16px 0 0 #3c4b49;
  }

  .arm {
    left: 210px;
    bottom: 132px;
    width: 190px;
    height: 24px;
    border-radius: 999px;
    background: #f5b544;
    transform: rotate(-26deg);
    transform-origin: left center;
  }

  .boom {
    right: 30px;
    bottom: 94px;
    width: 145px;
    height: 21px;
    border-radius: 999px;
    background: #d99322;
    transform: rotate(34deg);
  }

  .bucket {
    right: 18px;
    bottom: 42px;
    width: 66px;
    height: 54px;
    border-radius: 6px 6px 26px 26px;
    background: #3b4542;
    transform: rotate(-18deg);
  }

  .stats {
    position: absolute;
    left: 24px;
    bottom: 24px;
    display: grid;
    width: 190px;
    padding: 18px;
  }

  .stats strong {
    color: var(--green);
    font-size: 2.1rem;
    line-height: 1;
  }

  .stats span {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .service-grid,
  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 34px;
  }

  .service-grid article,
  .article-card {
    padding: 24px;
  }

  .service-grid h3,
  .article-card h3 {
    margin: 0 0 10px;
    font-size: 1.28rem;
    line-height: 1.25;
  }

  .service-grid p,
  .article-card p {
    margin: 0;
    color: var(--muted);
  }

  .equipment-section {
    background: #ffffff;
  }

  .equipment-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .equipment-list span {
    padding: 9px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #f7f9f6;
    font-weight: 750;
    text-transform: capitalize;
  }

  .process-section {
    background: #ecf2ee;
  }

  .process-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 42px;
  }

  .steps {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 14px;
    align-items: start;
    padding: 18px;
    border-radius: 8px;
    background: #ffffff;
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: var(--green);
    color: #ffffff;
    font-weight: 900;
  }

  .steps strong,
  .steps span {
    grid-column: 2;
  }

  .steps span {
    color: var(--muted);
  }

  .article-head {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: end;
  }

  .article-card span {
    display: inline-flex;
    margin-bottom: 12px;
    color: var(--green-2);
    font-size: 0.82rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .article-card a:hover {
    color: var(--green-2);
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
    }

    .hero-grid,
    .process-grid {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      min-height: 360px;
    }

    .service-grid,
    .article-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .hero {
      padding-top: 50px;
    }

    .hero-visual {
      min-height: 310px;
    }

    .machine {
      left: -4px;
      transform: scale(0.76);
      transform-origin: left bottom;
    }

    .article-head {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
